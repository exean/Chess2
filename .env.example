# Server
PORT=3000
NODE_ENV=production

# Public URL of the deployed app (used in links/CORS). Leave empty to allow any.
PUBLIC_ORIGIN=

# JWT secret for account sessions. Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# MySQL connection (from Plesk -> Datenbanken)
DB_HOST=localhost
DB_PORT=3306
DB_USER=chess2
DB_PASSWORD=changeme
DB_NAME=chess2

# Optional: username that should be granted admin rights at every server
# start. Useful for bootstrapping the first admin. Once set, the matching
# user account gets is_admin=1 on every migration run (idempotent).
# ADMIN_USER=your-username

# Optional: SMTP for password-reset emails. If unset, the forgot-password
# endpoint logs the reset link to the server console instead of sending mail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Chess2 <noreply@example.com>"
